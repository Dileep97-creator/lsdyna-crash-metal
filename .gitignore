# solver output - never commit these, they are large and regenerable
d3plot*
d3hsp
d3dump*
d3full*
binout*
dynain
runrsf*
*.log
messag
status.out
bg_switch
kill_by_pelib
glstat
matsum
rcforc
nodout
elout
secforc
spcforc
rwforc
bndout
swforc
