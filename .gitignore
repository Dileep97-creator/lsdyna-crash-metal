# solver run directories. Decks are regenerated by build.py and results
# are collected into <study>/results/ by collect_results.py, so the
# per-run working folders (several GB of output) never go in git.
runs/
0*/models/*/
results_extracted/

# LS-Run / LS-PrePost / solver clutter
*.lsda
lsrun*
lspost.*
adptmp
d3thdt*
group_file
cont_profile*
load_profile*
mes[0-9]*
scr[0-9]*

# Calibration outputs ARE committed on purpose: they are cheap to
# regenerate, they are what a reviewer looks at first, and the READMEs
# link to them.

# python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
